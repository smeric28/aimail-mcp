# ---------------------------------------------------------------------------
# AI Mail MCP — environment configuration
# Copy to .env (local) or set as secrets in your hosting platform.
# ---------------------------------------------------------------------------

# Transport: "stdio" (local Claude Desktop / OpenCode) or "http" (remote connector)
MCP_TRANSPORT=stdio

# --- Microsoft Entra app registration (Fireball tenant) ---
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret
# Use your tenant GUID for single-tenant, or "organizations" / "common" for multi-tenant
AZURE_TENANT_ID=your-tenant-id

# --- Remote (http) transport only ---
# Public HTTPS URL where this server is reachable (no trailing slash).
# Entra redirect URI must be <PUBLIC_BASE_URL>/auth/callback
PUBLIC_BASE_URL=https://aimail.fireballz.ai
PORT=8080

# --- Local (stdio) transport only ---
REDIRECT_URI=http://localhost:3000/callback

# --- Optional: Gmail provider (stdio multi-account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Folder/label used to store AI-generated drafts
DRAFTS_FOLDER_NAME=aiDrafts
